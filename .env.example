# Copia este archivo como .env y reemplaza los valores ilustrativos.
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>?retryWrites=true&w=majority
USUARIOS_DB=estudi_usuarios_db
# Opcional: usa este URI solo si las cuentas viven en otro clúster.
# USUARIOS_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base>?retryWrites=true&w=majority
# Define una clave persistente y aleatoria antes de desplegar en producción.
FLASK_SECRET_KEY=<clave-aleatoria-secreta>
# FLASK_DEBUG debe permanecer desactivado en producción.
# FLASK_DEBUG=0
